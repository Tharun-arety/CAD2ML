# Copy to .env. All values have safe local defaults; nothing here is a real secret.
CAD2ML_DATA_DIR=/data
CAD2ML_DATABASE_URL=postgresql+psycopg://cad2ml:${POSTGRES_PASSWORD}@postgres:5432/cad2ml
CAD2ML_QUEUE_URL=redis://valkey:6379/0
CAD2ML_LOG_LEVEL=INFO
CAD2ML_LOG_JSON=true
CAD2ML_WORKER_LEASE_S=60
CAD2ML_WORKER_HEARTBEAT_S=10
CAD2ML_MAX_ATTEMPTS=3
CAD2ML_ENABLE_FAULT_INJECTION=false
POSTGRES_PASSWORD=change-me-local-only
